{
  "name": "geosafe-frontend",
  "version": "1.0.0",
  "description": "GeoSafe - Disaster Reporting & Emergency Assistance System (Frontend Portals)",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "build": "npm run build:css"
  },
  "keywords": [
    "disaster-reporting",
    "emergency-assistance",
    "resident-portal",
    "geosafe",
    "tailwind"
  ],
  "author": "GeoSafe Team",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
