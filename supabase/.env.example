# ============================================================================
# GeoSafe Backend Environment Configuration for Supabase + Render
# Copy values into your deployment platform (Render) or backend/.env.
# NEVER commit real passwords, JWT secrets, or service-role keys.
# ============================================================================

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL (Supabase Connection Settings)
# Use Session Pooler (port 5432) or Direct Connection from Supabase Project Settings -> Database
DB_CLIENT=pg
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=REPLACE_WITH_SUPABASE_DB_PASSWORD
DB_NAME=postgres
DB_SSL=true

# Optional: Connection string alternative (leave blank if using DB_HOST/DB_USER/DB_PASSWORD above)
# DATABASE_URL=postgresql://postgres.your-project-ref:REPLACE_WITH_SUPABASE_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Authentication (Generate a strong random 64+ char secret)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_JWT_SECRET

# Supabase Storage (Server-Side Only — NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend JS)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Private Evidence Bucket Names
SUPABASE_BUCKET_INCIDENT_EVIDENCE=incident-evidence
SUPABASE_BUCKET_RESCUE_EVIDENCE=rescue-evidence
SUPABASE_BUCKET_RESCUE_COMPLETION=rescue-completion-evidence
